{
  "name": "uwifin",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:api": "cargo run --manifest-path services/api/Cargo.toml",
    "lint:web": "pnpm --dir apps/web lint",
    "check:api": "cargo check --manifest-path services/api/Cargo.toml",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "build:web": "pnpm --dir apps/web build",
    "test:web": "pnpm --dir apps/web test"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "jayson": "5.0.0",
      "js-cookie": "3.0.7"
    }
  }
}
