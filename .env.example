APP_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=mysql://uwifin:uwifin@localhost:3306/uwifin

# Start with Base Sepolia. Use base only after testnet verification.
ALCHEMY_NETWORK=base-sepolia
ALCHEMY_API_KEY=
ALCHEMY_POLICY_ID=
# Optional explicit provider endpoints (HTTPS in production):
# ALCHEMY_RPC_URL=
# ALCHEMY_WALLET_URL=
BLOCK_CONFIRMATIONS=3
MAX_TRANSFER_ATOMIC=1000000000

# Stripe Crypto Onramp requires approval, including test mode.
# On-ramp is enabled only for Base mainnet with all three keys configured.
STRIPE_ONRAMP_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
