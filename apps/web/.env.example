# Server-only Next.js BFF configuration. Never prefix provider secrets NEXT_PUBLIC_.
API_URL=http://127.0.0.1:8080
APP_BASE_URL=http://localhost:3000

# Optional browser-restricted Alchemy Signer key (separate from server API key).
# Enable email OTP and allow only the app's HTTPS origin in Alchemy.
NEXT_PUBLIC_ALCHEMY_SIGNER_KEY=
